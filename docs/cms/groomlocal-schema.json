          ]
        }
      ]
    },
    {
      "kind": "collection",
      "type": "faq",
      "title": "Frequently Asked Questions",
      "orderable": true,
      "publishable": true,
      "help": "Reusable answers for marketing pages. Only render FAQ structured data when the same content is visible on the page.",
      "fields": [
        {
          "name": "question",
          "type": "text",
          "title": "Question",
          "required": true
        },
        {
          "name": "answer",
          "type": "richText",
          "title": "Answer",
          "required": true
        },
        {
          "name": "audience",
          "type": "select",
          "title": "Audience",
          "options": [
            "pet-parents",
            "groomers",
            "both"
          ],
          "default": "both"
        }
      ]
    },
    {
      "kind": "collection",
      "type": "mauiIllustration",
      "title": "Maui Illustration Library",
      "orderable": false,
      "publishable": true,
      "help": "Upload true RGBA PNGs. Verify on teal/dark: four limbs, complete edges, approved face/proportions, red MAUI bandana. Preserve the fixed September 2026 references. New Hermes blogs require a newly generated scene; this library does not authorize recycling old artwork.",
      "fields": [
        {
          "name": "title",
          "type": "text",
          "title": "Scene name",
          "required": true
        },
        {
          "name": "image",
          "type": "image",
          "title": "Transparent PNG",
          "required": true
        },
        {
          "name": "alt",
          "type": "text",
          "title": "Image description",
          "required": true
        },
        {
          "name": "prompt",
          "type": "text",
          "title": "Generation prompt"
        },
        {
          "name": "appearanceReference",
          "type": "text",
          "title": "Approved appearance reference",
          "default": "September 2026 approved Maui — brushing-v2"
        },
        {
          "name": "generatedOn",
          "type": "date",
          "title": "Generated on"
        },
        {
          "name": "reviewedOn",
          "type": "date",
          "title": "Visually checked on"
        },
        {
          "name": "transparencyChecked",
          "type": "boolean",
          "title": "Real transparency checked",
          "default": false
        },
        {
          "name": "anatomyChecked",
          "type": "boolean",
          "title": "Anatomy and complete edges checked",
          "default": false
        },
        {
          "name": "review",
          "type": "object",
          "title": "Approval record",
          "fields": [
            {
              "name": "status",
              "type": "select",
              "title": "Artwork review",
              "required": true,
              "options": [
                "pending",
                "approved",
                "needs-fixes"
              ],
              "default": "pending"
            },
            {
              "name": "imageSha256",
              "type": "text",
              "title": "Reviewed image SHA-256",
              "description": "Digest of the exact downloaded final image. A replacement invalidates approval."
            },
            {
              "name": "reviewedOn",
              "type": "datetime",
              "title": "Reviewed at"
            },
            {
              "name": "reviewer",
              "type": "text",
              "title": "Visual reviewer"
            },
            {
              "name": "evidence",
              "type": "text",
              "title": "Review summary",
              "description": "Record reference comparison, anatomy, transparency, bandana, and full silhouette checks. A checkbox is not an image review."
            }
          ]
        }
      ]
    },
