# GroomLocal environment. Copy to .env.local for development; set the same names in Vercel.
# Names only. See src/lib/env.ts for what each one controls and /api/health for presence.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email via Resend. EMAIL_FROM must be a verified sender in production
# (the old name QUOTE_FROM_EMAIL is still honored).
RESEND_API_KEY=
EMAIL_FROM="GroomLocal <hello@groomlocal.com>"
QUOTE_NOTIFY_EMAIL=
LISTING_NOTIFY_EMAIL=
CONTACT_NOTIFY_EMAIL=

# Admin and automation
ADMIN_EMAILS=
CRON_SECRET=
HOUSE_LISTING_SLUG=

# Snackbox CMS
REVALIDATION_SECRET=
NEXT_PUBLIC_SNACKBOX_URL=https://snackboxcms.com
NEXT_PUBLIC_SNACKBOX_PROJECT=groomlocal

# Feature flags (build-time; changing them needs a redeploy)
NEXT_PUBLIC_SHOW_ADS=

# Data pipeline scripts only (never needed by the app)
FIRECRAWL_API_KEY=
GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Newsletter unsubscribe link signing (falls back to CRON_SECRET)
NEWSLETTER_UNSUBSCRIBE_SECRET=
