# Local Python virtualenv for background-removal scripts. 686MB and contains
# absolute symlinks that fail the Vercel build ("not a valid symlink").
.venv_rembg
.venv

# Local-only working files: never imported by the Next.js build.
screenshots
temp_scripts
grill-me-v1-takeaways
# Root folder only: an unanchored name also dropped src/app/admin/dashboard/outreach.
/outreach
# Private outreach snapshots and cleanup evidence stay on the owner's machine.
/.admin-cache
*.log
*.mp4
*.tsbuildinfo

# Preserved opaque source artwork is not needed by the site build.
docs/maui/opaque-masters
